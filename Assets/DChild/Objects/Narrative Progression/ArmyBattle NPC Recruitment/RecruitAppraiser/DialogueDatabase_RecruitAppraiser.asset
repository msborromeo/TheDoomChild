        value: 326
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: 'I call it the mantis. It was said centuries ago, there was a giant
          fight which emitted a bright light engulfing the whole realm. Afterwards,
          a few pores fell down in the garden and when it bloomed a bunch of mantis
          hatched. '
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
