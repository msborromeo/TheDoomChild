      - title: Conversant
        value: 326
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "Basically, destroying the ecosystem. The only good thing about them
          are their claws which can be turned into weapons.\r"
        type: 0
