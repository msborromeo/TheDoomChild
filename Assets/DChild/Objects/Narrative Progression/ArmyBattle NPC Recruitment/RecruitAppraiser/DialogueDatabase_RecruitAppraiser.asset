      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "The engravings on this knife are quite exquisite. What kind of creatures
          are these?\r"
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 837
      isRoot: 0
