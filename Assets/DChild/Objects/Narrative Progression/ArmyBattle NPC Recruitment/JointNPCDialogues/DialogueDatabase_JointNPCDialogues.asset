        destinationConversationID: 815
        destinationDialogueID: 10
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 30
        y: 470
        width: 160
        height: 30
    - id: 10
      fields:
      - title: Title
        value: 
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 326
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 326
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "Then, one day a man, wearing a loose fitting white veil and blue
          thawb came to my master\u2019s shop. He gave us 10,000 Dinari to forge
          this even though it wasn\u2019t the currency for Danbar. My master still
          accepted it and he gave this task to me.\r"
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 815
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
