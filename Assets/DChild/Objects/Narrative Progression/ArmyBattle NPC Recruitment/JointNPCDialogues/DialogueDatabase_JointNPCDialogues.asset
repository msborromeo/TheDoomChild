      - title: Conversant
        value: 326
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: 'You have a good eye. Yes, this sword was the first sword I ever made
          in Danbar. There was a legend that spoke of limitless treasure guarded
          by a dragon within the catacombs. So every adventure from every region
          was set on defeating the dragon. '
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 815
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
