      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 815
        originDialogueID: 10
        destinationConversationID: 815
        destinationDialogueID: 11
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 30
        y: 520
        width: 160
        height: 30
    - id: 11
      fields:
      - title: Title
        value: 
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 326
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 326
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "I set out on my journey to find a material that could withstand the
          dragon\u2019s flames. After months of searching for the perfect material
          for the sword. I came face to face with this fire golem and after a fierce
          battle."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 815
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
