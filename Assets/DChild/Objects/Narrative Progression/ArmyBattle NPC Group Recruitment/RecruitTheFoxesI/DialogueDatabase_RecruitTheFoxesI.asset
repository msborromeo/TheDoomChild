        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "If we are to help you, what guarantee do we have that the world we\u2019re
          saving won\u2019t shun little ones like us to the streets and left to fend
          for themselves."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 705
      isRoot: 0
      isGroup: 0
