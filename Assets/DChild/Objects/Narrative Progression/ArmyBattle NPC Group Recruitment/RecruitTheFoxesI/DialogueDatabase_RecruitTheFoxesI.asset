        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "That\u2019s not happiness nor is it peace. Its survival, its hiding,
          and you can only do it for so long."
        type: 0
        typeString: 
      - title: Sequence
