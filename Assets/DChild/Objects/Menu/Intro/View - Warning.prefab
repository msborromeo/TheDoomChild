    - target: {fileID: 3698319277505617516, guid: 2ca539a3458c72a449b2b1c3c35a9783,
        type: 3}
      propertyPath: mSource.mTerms.Array.data[0].Languages.Array.data[0]
      value: Photosensitivity Warning
      objectReference: {fileID: 0}
    - target: {fileID: 3698319277505617516, guid: 2ca539a3458c72a449b2b1c3c35a9783,
        type: 3}
      propertyPath: mSource.mTerms.Array.data[0].Languages.Array.data[1]
      value: Warnung Vor Lichtempfindlichkeit
      objectReference: {fileID: 0}
    - target: {fileID: 3698319277505617516, guid: 2ca539a3458c72a449b2b1c3c35a9783,
        type: 3}
      propertyPath: mSource.mTerms.Array.data[1].Languages.Array.data[0]
      value: 'Tips To Stay Safe:'
      objectReference: {fileID: 0}
    - target: {fileID: 3698319277505617516, guid: 2ca539a3458c72a449b2b1c3c35a9783,
        type: 3}
      propertyPath: mSource.mTerms.Array.data[1].Languages.Array.data[1]
      value: 'Tipps, Um Sicher Zu Bleiben:'
      objectReference: {fileID: 0}
    - target: {fileID: 3698319277505617516, guid: 2ca539a3458c72a449b2b1c3c35a9783,
        type: 3}
      propertyPath: mSource.mTerms.Array.data[2].Languages.Array.data[0]
      value: This game contains flashing lights, fast-moving patterns, and visual
        effects that may trigger seizures or other symptoms in individuals with photosensitive
        epilepsy. If you have a history of photosensitivity, consult your doctor
        before playing.
      objectReference: {fileID: 0}
    - target: {fileID: 3698319277505617516, guid: 2ca539a3458c72a449b2b1c3c35a9783,
        type: 3}
      propertyPath: mSource.mTerms.Array.data[2].Languages.Array.data[1]
      value: "Dieses Spiel enth\xE4lt blinkende Lichter, sich schnell bewegende Muster
        und visuelle Effekte, die bei Personen mit lichtempfindlicher Epilepsie Anf\xE4lle
        oder andere Symptome ausl\xF6sen k\xF6nnen. Wenn Sie in der Vergangenheit
        lichtempfindlich waren, konsultieren Sie vor dem Spielen Ihren Arzt."
      objectReference: {fileID: 0}
    - target: {fileID: 3698319277505617516, guid: 2ca539a3458c72a449b2b1c3c35a9783,
        type: 3}
      propertyPath: mSource.mTerms.Array.data[3].Languages.Array.data[0]
      value: Lower screen brightness.
      objectReference: {fileID: 0}
    - target: {fileID: 3698319277505617516, guid: 2ca539a3458c72a449b2b1c3c35a9783,
        type: 3}
      propertyPath: mSource.mTerms.Array.data[3].Languages.Array.data[1]
      value: Geringere Bildschirmhelligkeit.
      objectReference: {fileID: 0}
    - target: {fileID: 3698319277505617516, guid: 2ca539a3458c72a449b2b1c3c35a9783,
        type: 3}
      propertyPath: mSource.mTerms.Array.data[4].Languages.Array.data[0]
      value: Discontinue if you experience discomfort, and seek medical advice.
      objectReference: {fileID: 0}
    - target: {fileID: 3698319277505617516, guid: 2ca539a3458c72a449b2b1c3c35a9783,
        type: 3}
      propertyPath: mSource.mTerms.Array.data[4].Languages.Array.data[1]
      value: "Wenn Sie Beschwerden versp\xFCren, brechen Sie die Einnahme ab und
        suchen Sie \xE4rztlichen Rat."
      objectReference: {fileID: 0}
    - target: {fileID: 3698319277505617516, guid: 2ca539a3458c72a449b2b1c3c35a9783,
        type: 3}
      propertyPath: mSource.mTerms.Array.data[5].Languages.Array.data[0]
      value: Play in a well-lit room.
      objectReference: {fileID: 0}
    - target: {fileID: 3698319277505617516, guid: 2ca539a3458c72a449b2b1c3c35a9783,
        type: 3}
      propertyPath: mSource.mTerms.Array.data[5].Languages.Array.data[1]
      value: Spielen Sie in einem gut beleuchteten Raum.
      objectReference: {fileID: 0}
    - target: {fileID: 3698319277505617516, guid: 2ca539a3458c72a449b2b1c3c35a9783,
        type: 3}
      propertyPath: mSource.mTerms.Array.data[6].Languages.Array.data[0]
      value: Take frequent breaks.
      objectReference: {fileID: 0}
    - target: {fileID: 3698319277505617516, guid: 2ca539a3458c72a449b2b1c3c35a9783,
        type: 3}
      propertyPath: mSource.mTerms.Array.data[6].Languages.Array.data[1]
      value: "Machen Sie h\xE4ufig Pausen."
      objectReference: {fileID: 0}
    - target: {fileID: 7941182601525696955, guid: 2ca539a3458c72a449b2b1c3c35a9783,
        type: 3}
      propertyPath: m_RootOrder
