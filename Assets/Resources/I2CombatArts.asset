%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f0b0c553be8edd4682e9180fdd13e37, type: 3}
  m_Name: I2CombatArts
  m_EditorClassIdentifier: 
  mSource:
    UserAgreesToHaveItOnTheScene: 0
    UserAgreesToHaveItInsideThePluginsFolder: 0
    GoogleLiveSyncIsUptoDate: 1
    mTerms:
    - Term: PrimarySkill/ReaperHarvest/ReaperHarvest_Name
      TermType: 0
      Description: 
      Languages:
      - Reaper Harvest
      - Schnitternte
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/ReaperHarvest/ReaperHarvest_Controls
      TermType: 0
      Description: 
      Languages:
      - (While Grounded) Hold <color="red"> Left Shift </color> + Press/Hold <color="red">
        A </color> or <color="red"> D </color> + Press <color="red"> Left Click </color>
      - "(W\xE4hrend Sie geerdet sind) Halten Sie <color=\"red\"> linke Umschalttaste
        </color> <color=\"red\"> dr\xFCcken/halten Sie <color=\"red\"> A </color>
        oder <color=\"red\"> D </color> <color=\"red\"> dr\xFCcken Sie <color=\"red\">
        linke Maustaste </color> "
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/ReaperHarvest/ReaperHarvest_Description1
      TermType: 0
      Description: 
      Languages:
      - "Reaper\u2019s Harvest grants you the power of the underworld by conjuring
        a scythe. Recover life points based on the damage you deal while unleashing
        a quick and critical dash & slash."
      - "Reaper\u2019s Harvest gew\xE4hrt Ihnen die Macht der Unterwelt, indem Sie
        eine Sense beschw\xF6ren. Gewinnen Sie Lebenspunkte basierend auf dem Schaden
        zur\xFCck, den Sie verursachen, w\xE4hrend Sie einen schnellen und kritischen
        Sprint und Hieb ausf\xFChren."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/SovereignImpale/SovereignImpale_Name
      TermType: 0
      Description: 
      Languages:
      - Sovereign's Impale
      - Der Pfahl Des Herrschers
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/SovereignImpale/SovereignImpale_Controls
      TermType: 0
      Description: 
      Languages:
      - (While Grounded) Hold <color="red"> Left Shift </color> + Press/Hold <color="red">
        S </color> + Press <color="red"> Left Click </color>
      - "(w\xE4hrend des Bodens) gedr\xFCckt halten <color=\"red\"> linke Umschalttaste
        </color> <color=\"red\"> dr\xFCcken/halten <color=\"red\"> s </color> <color=\"red\">
        dr\xFCcken <color=\"red\"> Linksklick </color> "
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/SovereignImpale/SovereignImpale_Description1
      TermType: 0
      Description: 
      Languages:
      - Conjure deadly blade spikes that impale enemies.
      - "Beschw\xF6re t\xF6dliche Klingenstacheln, die Feinde aufspie\xDFen."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/HellTrident/HellTrident_Name
      TermType: 0
      Description: 
      Languages:
      - Hell Trident
      - "H\xF6llen-Dreizack"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/HellTrident/HellTrident_Controls
      TermType: 0
      Description: 
      Languages:
      - (While Grounded) Hold <color="red"> Left Shift </color> + Press/Hold <color="red">A</color>
        or <color="red">D</color> + Press <color="red">F </color>
      - "(W\xE4hrend Sie geerdet sind) Halten Sie <color=\"red\"> linke Umschalttaste
        </color> <color=\"red\"> dr\xFCcken/halten Sie <color=\"red\"> A</color>
        oder <color=\"red\"> D</color> <color=\"red\"> dr\xFCcken Sie <color=\"red\">
        F </color> "
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/HellTrident/HellTrident_Description1
      TermType: 0
      Description: 
      Languages:
      - Throws a trident from hell that deals significant damage and applies knockback.
      - "Wirft einen Dreizack aus der H\xF6lle, der erheblichen Schaden verursacht
        und einen R\xFCcksto\xDF ausl\xF6st."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/FoolsVerdict/FoolsVerdict_Name
      TermType: 0
      Description: 
      Languages:
      - Fool's Verdict
      - Narrenurteil
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/FoolsVerdict/FoolsVerdict_Controls
      TermType: 0
      Description: 
      Languages:
      - (While Grounded) Hold <color="red">Left Shift </color> + Press/Hold <color="red">W
        </color> + Press <color="red">F </color>
      - "(w\xE4hrend des Bodenkontakts) gedr\xFCckt halten <color=\"red\"> linke
        Umschalttaste </color> <color=\"red\"> dr\xFCcken/halten <color=\"red\">
        w </color> <color=\"red\"> dr\xFCcken <color=\"red\"> f </color> "
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/FoolsVerdict/FoolsVerdict_Description1
      TermType: 0
      Description: 
      Languages:
      - Evoke a giant gavel for a chance to instantly kill enemies.
      - "Beschw\xF6re einen riesigen Hammer, um die Chance zu haben, Feinde sofort
        zu t\xF6ten."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/SoulfireBlast/SoulfireBlast_Name
      TermType: 0
      Description: 
      Languages:
      - Soul Fire Blast
      - "Seelenfeuersto\xDF"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/SoulfireBlast/SoulfireBlast_Controls
      TermType: 0
      Description: 
      Languages:
      - (While Midair) Hold <color="red"> Left Shift </color> + Press <color="red">
        F </color>
      - "(in der Luft) <color=\"red\"> linke Umschalttaste </color> gedr\xFCckt halten
        <color=\"red\"> <color=\"red\"> f </color> dr\xFCcken "
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/SoulfireBlast/SoulfireBlast_Description1
      TermType: 0
      Description: 
      Languages:
      - The Soul Fire Blast Combat Art grants you the power of the underworld. To
        cast and unleash the Skull Frame Cuirass for a volatile soul-charged energy
        blast, you must be levitating.
      - "Die Soul Fire Blast Combat Art verleiht dir die Macht der Unterwelt. Um
        den Skull Frame Cuirass zu wirken und zu entfesseln, um einen fl\xFCchtigen,
        seelengeladenen Energiesto\xDF auszul\xF6sen, m\xFCssen Sie schweben."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/EdgedFury/EdgedFury_Name
      TermType: 0
      Description: 
      Languages:
      - Edged Fury
      - Kantiger Zorn
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/EdgedFury/EdgedFury_Controls
      TermType: 0
      Description: 
      Languages:
      - (While Midair) Hold <color="red">Left Shift </color> + Hold <color="red">Right
        Click </color>
      - "(in der Luft) gedr\xFCckt halten <color=\"red\"> linke Umschalttaste </color>
        <color=\"red\"> gedr\xFCckt halten <color=\"red\"> Rechtsklick </color> "
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/EdgedFury/EdgedFury_Description1
      TermType: 0
      Description: 
      Languages:
      - Unleash the fury of your whip blades as you become a whirlwind of destruction.
      - "Entfessle die Wut deiner Peitschenklingen und verwandle dich in einen Wirbelsturm
        der Zerst\xF6rung."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/BackDiver/BackDiver_Name
      TermType: 0
      Description: 
      Languages:
      - Back Diver
      - "R\xFCckentaucher"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/BackDiver/BackDiver_Controls
      TermType: 0
      Description: 
      Languages:
      - '(While Grounded) Hold <color="red"> Left Shift </color>+ Press/Hold <color="red">S
        </color> + Press <color="red">Spacebar</color>

'
      - "(w\xE4hrend des Bodens) gedr\xFCckt halten <color=\"red\"> linke Umschalttaste
        </color> <color=\"red\"> dr\xFCcken/halten <color=\"red\"> s </color> <color=\"red\">
        dr\xFCcken <color=\"red\"> Leertaste</color> \n"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/BackDiver/BackDiver_Description1
      TermType: 0
      Description: 
      Languages:
      - Back Diver Combat Art allows evasive action through a quick backflip to dodge
        incoming attacks and for your repositioning during combat.
      - "Die Back Diver Combat Art erm\xF6glicht Ausweichman\xF6ver durch einen schnellen
        R\xFCckw\xE4rtssalto, um eingehenden Angriffen auszuweichen und dich w\xE4hrend
        des Kampfes neu zu positionieren."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Barrier/Barrier_Name
      TermType: 0
      Description: 
      Languages:
      - Barrier
      - Barriere
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Barrier/Barrier_Controls
      TermType: 0
      Description: 
      Languages:
      - '(While Grounded) Press and hold <color="red">Z </color> '
      - "(Bei geerdetem Boden) Halten Sie <color=\"red\">Z</color> gedr\xFCckt  "
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Barrier/Barrier_Description1
      TermType: 0
      Description: 
      Languages:
      - "Barrier Combat Art casts a shield for damage absorption for safety in battle.
        This however, makes you immobile while active so time wisely.\r"
      - "Barrier Combat Art wirft einen Schild zur Schadensabsorption und zur Sicherheit
        im Kampf. Dies f\xFChrt jedoch dazu, dass Sie sich nicht bewegen k\xF6nnen,
        wenn Sie aktiv sind, also sollten Sie die Zeit sinnvoll einplanen.\r"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Barrier/Barrier_Description2
      TermType: 0
      Description: 
      Languages:
      - Barrier II is an upgraded version of the initial barrier and allows mobility
        while the shield is active, enhancing protection during combat.
      - "Barrier II ist eine verbesserte Version der urspr\xFCnglichen Barriere und
        erm\xF6glicht Mobilit\xE4t, w\xE4hrend der Schild aktiv ist, wodurch der
        Schutz im Kampf verbessert wird."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/DiagonalSwordDash/DiagonalSwordDash_Name
      TermType: 0
      Description: 
      Languages:
      - Diagonal Sword Dash
      - Diagonaler Schwertstrich
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/DiagonalSwordDash/DiagonalSwordDash_Controls
      TermType: 0
      Description: 
      Languages:
      - '(While Midair) Hold <color="red"> Left Shift </color> + Press/Hold <color="red">S
        </color> + Press <color="red">Left Click </color> '
      - "(in der Luft) gedr\xFCckt halten <color=\"red\"> linke Umschalttaste </color>
        <color=\"red\"> dr\xFCcken/halten <color=\"red\"> s </color> <color=\"red\">
        dr\xFCcken <color=\"red\"> Linksklick </color>  "
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/DiagonalSwordDash/DiagonalSwordDash_Description1
      TermType: 0
      Description: 
      Languages:
      - Swiftly dash diagonally at lightning speeds toward the ground, damaging enemies
        in your path.
      - "Flitze blitzschnell diagonal auf den Boden zu und f\xFCge Feinden auf deinem
        Weg Schaden zu."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/LightningSpear/LightningSpear_Name
      TermType: 0
      Description: 
      Languages:
      - Lightning Spear Throw
      - Blitzspeerwurf
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/LightningSpear/LightningSpear_Controls
      TermType: 0
      Description: 
      Languages:
      - (While Midair) Hold <color="red">Left Shift </color> +Press/Hold <color="red">S
        </color> + Press/Hold <color="red">Right Click </color>
      - "(in der Luft) gedr\xFCckt halten <color=\"red\"> linke Umschalttaste </color>
        <color=\"red\"> dr\xFCcken/halten <color=\"red\"> s </color> <color=\"red\">
        dr\xFCcken/halten <color=\"red\"> Rechtsklick </color> "
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/LightningSpear/LightningSpear_Description1
      TermType: 0
      Description: 
      Languages:
      - "While mid-air, unleash the Lightning Spear Combat \r\nArts by throwing it
        diagonally toward the ground, \r\nexploding upon impact and stunning enemies,
        leaving \r\nthem vulnerable to attacks.\r\n"
      - "Entfessle in der Luft den Lightning Spear Combat \r\nKunst, indem man es
        diagonal auf den Boden wirft, \r\nexplodiert beim Aufprall, bet\xE4ubt Feinde
        und geht \r\nsie anf\xE4llig f\xFCr Angriffe.\r\n"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/IcarusWings/IcarusWings_Name
      TermType: 0
      Description: 
      Languages:
      - Icarus Wings
      - "Ikarus-Fl\xFCgel"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/IcarusWings/IcarusWings_Controls
      TermType: 0
      Description: 
      Languages:
      - Press/Hold <color="red">W</color> + <color="red">Spacebar</color>
      - "Dr\xFCcken/halten Sie <color=\"red\"> w</color> <color=\"red\"> <color=\"red\">
        Leertaste</color> "
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/IcarusWings/IcarusWings_Description1
      TermType: 0
      Description: 
      Languages:
      - "The unholy power of Icarus Wings allows you \r\nto soar high and strike
        enemies from above, \r\nthese wings also allow you to traverse different
        \r\nterrain to explore hidden areas and secrets.\r"
      - "Die unheilige Kraft der Ikarus-Fl\xFCgel erm\xF6glicht es Ihnen \r\nhoch
        zu fliegen und Feinde von oben zu treffen, \r\nMit diesen Fl\xFCgeln k\xF6nnen
        Sie auch verschiedene Durchquerungen durchf\xFChren \r\nGel\xE4nde, um verborgene
        Gebiete und Geheimnisse zu erkunden.\r"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/TeleportingSkull/TeleportingSkull_Name
      TermType: 0
      Description: 
      Languages:
      - Teleporting Skull
      - "Teleportierender Sch\xE4del"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/TeleportingSkull/TeleportingSkull_Controls
      TermType: 0
      Description: 
      Languages:
      - (While Grounded) Press and Hold <color="red">Left Shift </color>+ Press 
        <color="red">F</color>, To Aim Press and Hold <color="red">Left Shift </color>+
        Press and Hold <color="red">F</color>
      - "(W\xE4hrend des Bodens) Dr\xFCcken und halten Sie <color=\"red\"> linke
        Umschalttaste </color> <color=\"red\"> dr\xFCcken Sie <color=\"red\"> F</color>.
        Zum Zielen dr\xFCcken und halten Sie <color=\"red\"> linke Umschalttaste
        </color> <color=\"red\"> dr\xFCcken und halten Sie <color=\"red\"> F</color> "
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/TeleportingSkull/TeleportingSkull_Description1
      TermType: 0
      Description: 
      Languages:
      - The upgraded variant of the Skull Throw where you can teleport to the thrown
        skull's position before unleashing a circular burst damaging attack maximizing
        your combat efficiency.
      - "Die verbesserte Variante des Sch\xE4delwurfs, bei der Sie sich zur Position
        des geworfenen Sch\xE4dels teleportieren k\xF6nnen, bevor Sie einen kreisf\xF6rmigen
        Schadenssto\xDF ausl\xF6sen, der Ihre Kampfeffizienz maximiert."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/AirSlashRange/AirSlashRange_Name
      TermType: 0
      Description: 
      Languages:
      - Air Slash Ranged
      - Luftangriff Aus Der Ferne
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/AirSlashRange/AirSlashRange_Controls
      TermType: 0
      Description: 
      Languages:
      - (While Midair) Hold <color="red">Left Shift </color> +Press/Hold <color="red">S
        </color> + Press/Hold <color="red">Right Click </color>
      - "(in der Luft) gedr\xFCckt halten <color=\"red\"> linke Umschalttaste </color>
        <color=\"red\"> dr\xFCcken/halten <color=\"red\"> s </color> <color=\"red\">
        dr\xFCcken/halten <color=\"red\"> Rechtsklick </color> "
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/AirSlashRange/AirSlashRange_Description1
      TermType: 0
      Description: 
      Languages:
      - "Take your combat to the air with the Air Slash Combat Art. \r\nWhile in
        mid-air, you're able to unleash a single projectile that strikes diagonally
        toward the ground."
      - "Bringen Sie Ihren Kampf mit der Air Slash Combat Art in die Luft. \r\n\nIn
        der Luft k\xF6nnen Sie ein einzelnes Projektil abfeuern, das diagonal auf
        den Boden trifft."
      Flags: 0000
      Languages_Touch: []
    CaseInsensitiveTerms: 0
    OnMissingTranslation: 1
    mTerm_AppName: 
    mLanguages:
    - Name: English
      Code: en
      Flags: 0
    - Name: German
      Code: de
      Flags: 0
