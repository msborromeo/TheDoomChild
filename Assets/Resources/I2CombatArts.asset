%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f0b0c553be8edd4682e9180fdd13e37, type: 3}
  m_Name: I2CombatArts
  m_EditorClassIdentifier: 
  mSource:
    UserAgreesToHaveItOnTheScene: 0
    UserAgreesToHaveItInsideThePluginsFolder: 0
    GoogleLiveSyncIsUptoDate: 1
    mTerms:
    - Term: PrimarySkill/ReaperHarvest/ReaperHarvest_Name
      TermType: 0
      Description: 
      Languages:
      - Reaper Harvest
      - Schnitternte
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/ReaperHarvest/ReaperHarvest_Controls
      TermType: 0
      Description: 
      Languages:
      - (While Grounded) Hold BUTTONPROMPT + Press/Hold SECONDPROMPT or SECONDPROMPT
        + Press THIRDPROMPT
      - "(W\xE4hrend Sie am Boden sind) Halten Sie die BUTTONPROMPT gedr\xFCckt +
        dr\xFCcken/halten Sie SECONDPROMPT oder SECONDPROMPT + dr\xFCcken Sie THIRDPROMPT"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/ReaperHarvest/ReaperHarvest_Description1
      TermType: 0
      Description: 
      Languages:
      - Grants you the power of the underworld by conjuring a scythe. Recover life
        points based on the damage you deal while unleashing a quick and critical
        dash & slash.
      - "Verleiht dir die Macht der Unterwelt, indem du eine Sense beschw\xF6rst.
        Regeneriere Lebenspunkte basierend auf dem verursachten Schaden, w\xE4hrend
        du einen schnellen und kritischen Sturmangriff ausf\xFChrst."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/SovereignImpale/SovereignImpale_Name
      TermType: 0
      Description: 
      Languages:
      - Sovereign's Impale
      - Der Pfahl Des Herrschers
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/SovereignImpale/SovereignImpale_Controls
      TermType: 0
      Description: 
      Languages:
      - (While Grounded) Hold BUTTONPROMPT + Press/Hold SECONDPROMPT + Press THIRDPROMPT
      - "(W\xE4hrend Sie am Boden sind) Halten Sie die BUTTONPROMPT gedr\xFCckt +
        dr\xFCcken/halten Sie SECONDPROMPT + dr\xFCcken Sie die THIRDPROMPT"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/SovereignImpale/SovereignImpale_Description1
      TermType: 0
      Description: 
      Languages:
      - Conjure deadly blade spikes that impale enemies.
      - "Beschw\xF6re t\xF6dliche Klingenstacheln, die Feinde aufspie\xDFen."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/HellTrident/HellTrident_Name
      TermType: 0
      Description: 
      Languages:
      - Hell Trident
      - "H\xF6llen-Dreizack"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/HellTrident/HellTrident_Controls
      TermType: 0
      Description: 
      Languages:
      - (While Grounded) Hold BUTTONPROMPT + Press/Hold SECONDPROMPT or SECONDPROMPT
        + Press THIRDPROMPT
      - "(W\xE4hrend Sie am Boden sind) Halten Sie die BUTTONPROMPT gedr\xFCckt +
        dr\xFCcken/halten Sie SECONDPROMPT oder SECONDPROMPT + dr\xFCcken Sie THIRDPROMPT"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/HellTrident/HellTrident_Description1
      TermType: 0
      Description: 
      Languages:
      - Throws a trident from hell that deals significant damage and applies knockback.
      - "Wirft einen Dreizack aus der H\xF6lle, der erheblichen Schaden verursacht
        und einen R\xFCcksto\xDF ausl\xF6st."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/FoolsVerdict/FoolsVerdict_Name
      TermType: 0
      Description: 
      Languages:
      - Fool's Verdict
      - Narrenurteil
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/FoolsVerdict/FoolsVerdict_Controls
      TermType: 0
      Description: 
      Languages:
      - (While Grounded) Hold <color="red"><size=7px>BUTTONPROMPT</size></color>
        + Press/Hold <color="red"><size=7px>SECONDPROPMT</size></color> + Press <color="red"><size=7px>THIRDPROMPT</size></color>
      - "(W\xE4hrend Sie am Boden sind) Halten Sie die <color=\"red\"><size=7px>BUTTONPROMPT</size></color>
        gedr\xFCckt + dr\xFCcken/halten Sie <color=\"red\"><size=7px>SECONDPROMPT</size></color>
        + dr\xFCcken Sie <color=\"red\"><size=7px>THIRDPROMPT</size></color>"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/FoolsVerdict/FoolsVerdict_Description1
      TermType: 0
      Description: 
      Languages:
      - Evoke a giant gavel for a chance to instantly kill enemies.
      - "Beschw\xF6re einen riesigen Hammer, um die Chance zu haben, Feinde sofort
        zu t\xF6ten."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/SoulfireBlast/SoulfireBlast_Name
      TermType: 0
      Description: 
      Languages:
      - Soul Fire Blast
      - "Seelenfeuersto\xDF"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/SoulfireBlast/SoulfireBlast_Controls
      TermType: 0
      Description: 
      Languages:
      - (While Midair) Hold BUTTONPROMPT + Press SECONDPROMPT
      - "(In der Luft) Halten Sie die BUTTONPROMPT gedr\xFCckt und dr\xFCcken Sie
        SECONDPROMPT"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/SoulfireBlast/SoulfireBlast_Description1
      TermType: 0
      Description: 
      Languages:
      - Grants you the power of the underworld. To cast and unleash the Skull Frame
        Cuirass for a volatile soul-charged energy blast, you must be levitating.
      - "Verleiht dir die Macht der Unterwelt. Um den Sch\xE4delrahmen-K\xFCrass
        zu wirken und einen explosiven, seelengeladenen Energiesto\xDF zu entfesseln,
        musst du schweben."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/EdgedFury/EdgedFury_Name
      TermType: 0
      Description: 
      Languages:
      - Edged Fury
      - Kantiger Zorn
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/EdgedFury/EdgedFury_Controls
      TermType: 0
      Description: 
      Languages:
      - (While Midair) Hold BUTTONPROMPT + Hold SECONDPROMPT
      - "(In der Luft) Halten Sie die BUTTONPROMPT gedr\xFCckt + halten Sie die SECONDPROMPT"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/EdgedFury/EdgedFury_Description1
      TermType: 0
      Description: 
      Languages:
      - Unleash the fury of your whip blades as you become a whirlwind of destruction.
      - "Entfessle die Wut deiner Peitschenklingen und verwandle dich in einen Wirbelsturm
        der Zerst\xF6rung."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/BackDiver/BackDiver_Name
      TermType: 0
      Description: 
      Languages:
      - Back Diver
      - "R\xFCckentaucher"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/BackDiver/BackDiver_Controls
      TermType: 0
      Description: 
      Languages:
      - '(While Grounded) Hold BUTTONPROMPT + Press/Hold SECONDPROMPT + Press THIRDPROMPT

'
      - "(W\xE4hrend Sie am Boden sind) Halten Sie die BUTTONPROMPT gedr\xFCckt +
        dr\xFCcken/halten Sie SECONDPROMPT + dr\xFCcken Sie THIRDPROMPT"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/BackDiver/BackDiver_Description1
      TermType: 0
      Description: 
      Languages:
      - Allows evasive action through a quick backflip to dodge incoming attacks
        and for your repositioning during combat.
      - "Erm\xF6glicht Ausweichman\xF6ver durch einen schnellen R\xFCckw\xE4rtssalto,
        um ankommenden Angriffen zu entgehen und sich im Kampf neu zu positionieren."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Barrier/Barrier_Name
      TermType: 0
      Description: 
      Languages:
      - Barrier
      - Barriere
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Barrier/Barrier_Controls
      TermType: 0
      Description: 
      Languages:
      - (While Grounded) Press and hold  BUTTONPROMPT
      - "(Bei Bodenkontakt) Taste BUTTONPROMPT gedr\xFCckt halten"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Barrier/Barrier_Description1
      TermType: 0
      Description: 
      Languages:
      - "Casts a shield for damage absorption for safety in battle. This however,
        makes you immobile while active so time wisely.\r"
      - "Wirkt einen Schutzschild, der Schaden absorbiert und so im Kampf f\xFCr
        Sicherheit sorgt. Allerdings macht er dich w\xE4hrend seiner Wirkungsdauer
        bewegungsunf\xE4hig, also setze ihn mit Bedacht ein."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Barrier/Barrier_Description2
      TermType: 0
      Description: 
      Languages:
      - The upgraded version of the initial Barrier. It now allows mobility while
        the shield is active, enhancing protection during combat.
      - "Die verbesserte Version der urspr\xFCnglichen Barriere. Sie erm\xF6glicht
        nun Bewegungsfreiheit, w\xE4hrend der Schild aktiv ist, und erh\xF6ht so
        den Schutz im Kampf."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/DiagonalSwordDash/DiagonalSwordDash_Name
      TermType: 0
      Description: 
      Languages:
      - Diagonal Sword Dash
      - Diagonaler Schwertstrich
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/DiagonalSwordDash/DiagonalSwordDash_Controls
      TermType: 0
      Description: 
      Languages:
      - (While Midair) Hold BUTTONPROMPT + Press/Hold SECONDPROMPT + Press THIRDPROMPT
      - "(In der Luft) Halten Sie die BUTTONPROMPT gedr\xFCckt + dr\xFCcken/halten
        Sie SECONDPROMPT + dr\xFCcken Sie die THIRDPROMPT"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/DiagonalSwordDash/DiagonalSwordDash_Description1
      TermType: 0
      Description: 
      Languages:
      - Swiftly dash diagonally at lightning speeds toward the ground, damaging enemies
        in your path.
      - "Flitze blitzschnell diagonal auf den Boden zu und f\xFCge Feinden auf deinem
        Weg Schaden zu."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/LightningSpear/LightningSpear_Name
      TermType: 0
      Description: 
      Languages:
      - Lightning Spear Throw
      - Blitzspeerwurf
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/LightningSpear/LightningSpear_Controls
      TermType: 0
      Description: 
      Languages:
      - (While Midair) Hold BUTTONPROMPT +Press/Hold SECONDPROMPT + Press/Hold THIRDPROMPT
      - "(In der Luft) Halten Sie BUTTONPROMPT gedr\xFCckt + Dr\xFCcken/Halten Sie
        SECONDPROMPT + Dr\xFCcken/Halten Sie THIRDPROMPT"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/LightningSpear/LightningSpear_Description1
      TermType: 0
      Description: 
      Languages:
      - Throw the Lightning Spear mid-air to trigger a ground explosion that stuns
        enemies and leaves them vulnerable.
      - "Wirf den Blitzspeer in der Luft, um eine Bodenexplosion auszul\xF6sen, die
        Feinde bet\xE4ubt und sie verwundbar macht."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/IcarusWings/IcarusWings_Name
      TermType: 0
      Description: 
      Languages:
      - Icarus Wings
      - "Ikarus-Fl\xFCgel"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/IcarusWings/IcarusWings_Controls
      TermType: 0
      Description: 
      Languages:
      - Press/Hold BUTTONPROMPT + SECONDPROMPT
      - "Dr\xFCcken/Halten Sie BUTTONPROMPT + SECONDPROMPT"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/IcarusWings/IcarusWings_Description1
      TermType: 0
      Description: 
      Languages:
      - Harness the unholy power of Icarus Wings to soar above enemies and traverse
        difficult terrain to uncover hidden secrets.
      - "Nutze die unheilige Macht der Ikarusfl\xFCgel, um \xFCber Feinde hinwegzufliegen
        und schwieriges Gel\xE4nde zu durchqueren, um verborgene Geheimnisse aufzudecken."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/TeleportingSkull/TeleportingSkull_Name
      TermType: 0
      Description: 
      Languages:
      - Teleporting Skull
      - "Teleportierender Sch\xE4del"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/TeleportingSkull/TeleportingSkull_Controls
      TermType: 0
      Description: 
      Languages:
      - (While Grounded) Press and Hold BUTTONPROMPT + Press SECONDPROMPT
      - "(Am Boden) Dr\xFCcken und halten Sie die BUTTONPROMPT + Dr\xFCcken Sie SECONDPROMPT"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/TeleportingSkull/TeleportingSkull_Description1
      TermType: 0
      Description: 
      Languages:
      - The upgraded Skull Throw where you can teleport to the thrown skull's position
        before unleashing a circular burst attack, maximizing your combat efficiency.
      - "Der verbesserte Sch\xE4delwurf, bei dem man sich zur Position des geworfenen
        Sch\xE4dels teleportieren kann, bevor man einen kreisf\xF6rmigen Sto\xDFangriff
        ausl\xF6st, wodurch die Kampfeffizienz maximiert wird."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/AirSlashRange/AirSlashRange_Name
      TermType: 0
      Description: 
      Languages:
      - Air Slash Ranged
      - Luftangriff Aus Der Ferne
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/AirSlashRange/AirSlashRange_Controls
      TermType: 0
      Description: 
      Languages:
      - (While Midair) Hold BUTTONPROMPT + Press/Hold SECONDPROMPT + Press/Hold THIRDPROMPT
      - "(In der Luft) Halten Sie die BUTTONPROMPT gedr\xFCckt + Dr\xFCcken/Halten
        Sie SECONDPROMPT + Dr\xFCcken/Halten Sie die THIRDPROMPT"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/AirSlashRange/AirSlashRange_Description1
      TermType: 0
      Description: 
      Languages:
      - "\rWhile in mid-air, you're able to unleash a single projectile that strikes
        diagonally toward the ground."
      - "W\xE4hrend du dich in der Luft befindest, kannst du ein einzelnes Projektil
        abfeuern, das diagonal auf den Boden trifft."
      Flags: 0000
      Languages_Touch: []
    CaseInsensitiveTerms: 0
    OnMissingTranslation: 1
