    mTerms:
    - Term: PrimarySkill/Black Blood Immunity/Black Blood Immunity_Name
      TermType: 0
      Description: 
      Languages:
      - Black Blood Immunity
      - "Immunit\xE4t Gegen Schwarzes Blut"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Black Blood Immunity/Black Blood Immunity_Description
      TermType: 0
      Description: 
      Languages:
      - This enhancement grants the player immunity to walk through black blood without
        taking any damage.
      - "Diese Verbesserung gew\xE4hrt dem Spieler Immunit\xE4t, durch schwarzes
        Blut zu gehen, ohne Schaden zu nehmen."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Black Blood Immunity/Black Blood Immunity_Instruction
      TermType: 0
      Description: 
      Languages:
      - Walk through black blood
      - "\rGehe durch schwarzes Blut"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Dash/Dash_Name
      TermType: 0
      Description: 
      Languages:
      - Dash
      - Bindestrich
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Dash/Dash_Description
      TermType: 0
      Description: 
      Languages:
      - 'Allows you to quickly traverse forward on ground or in mid-air. '
      - "Erm\xF6glicht schnelle Vorw\xE4rtsbewegungen am Boden oder in der Luft. "
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Dash/Dash_Instruction
      TermType: 0
      Description: 
      Languages:
      - Press BUTTONPROMPT to Dash
      - "Dr\xFCcken Sie BUTTONPROMPT, um zu sprinten"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Double Jump/Double Jump_Name
      TermType: 0
      Description: 
      Languages:
      - Double Jump
      - Doppelsprung
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Double Jump/Double Jump_Description
      TermType: 0
      Description: 
      Languages:
      - Allow you to perform one (1) extra jump while in mid-air.
      - "Erm\xF6glicht Ihnen, in der Luft einen (1) zus\xE4tzlichen Sprung auszuf\xFChren."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Double Jump/Double Jump_Instruction
      TermType: 0
      Description: 
      Languages:
      - Press BUTTONPROMPT, while in mid-air
      - "Dr\xFCcken Sie BUTTONPROMPT, w\xE4hrend Sie sich in der Luft befinden"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Devil Wings/Devil Wings_Name
      TermType: 0
      Description: 
      Languages:
      - Devil Wings
      - "Teufelsfl\xFCgel"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Devil Wings/Devil Wings_Description
      TermType: 0
      Description: 
      Languages:
      - Allows you to levitate horizontally while in mid-air.
      - "Erm\xF6glicht das horizontale Schweben in der Luft."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Devil Wings/Devil Wings_Instruction
      TermType: 0
      Description: 
      Languages:
      - Hold BUTTONPROMPT while in mid-air
      - "Halten Sie BUTTONPROMPT gedr\xFCckt, w\xE4hrend Sie sich in der Luft befinden"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Shadow Dash/Shadow Dash_Name
      TermType: 0
      Description: 
      Languages:
      - Shadow Dash
      - Schattenstrich
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Shadow Dash/Shadow Dash_Description
      TermType: 0
      Description: 
      Languages:
      - 'Allows you to quickly traverse forward and pass-through the enemy''s attack
        and obstacles at the same time. '
      - "Erm\xF6glicht es Ihnen, schnell vorw\xE4rts zu gehen und gleichzeitig den
        Angriff und die Hindernisse des Feindes zu \xFCberwinden. "
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Shadow Dash/Shadow Dash_Instruction
      TermType: 0
      Description: 
      Languages:
      - BUTTONPROMPT
      - BUTTONPROMPT
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Shadow Slide/Shadow Slide_Name
      TermType: 0
      Description: 
      Languages:
      - Shadow Slide
      - Schattenrutsche
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Shadow Slide/Shadow Slide_Description
      TermType: 0
      Description: 
      Languages:
      - Its sliding, but in the shadows.
      - Es gleitet, aber im Schatten.
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Shadow Slide/Shadow Slide_Instruction
      TermType: 0
      Description: 
      Languages:
      - BUTTONPROMPT then press SECONDPROMPT
      - "BUTTONPROMPT und dann SECONDPROMPT dr\xFCcken"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Wall Movement/Wall Movement_Name
      TermType: 0
      Description: 
      Languages:
      - Wall Movement
      - Wandbewegung
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Wall Movement/Wall Movement_Description
      TermType: 0
      Description: 
      Languages:
      - Allows you to traverse upward by jumping through walls.
      - "Erm\xF6glicht Ihnen, nach oben zu gelangen, indem Sie durch W\xE4nde springen."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Wall Movement/Wall Movement_Instruction
      TermType: 0
      Description: 
      Languages:
      - BUTTONPROMPT, while holding SECONDPROMPT or THIRDPROMPT towards the wall
      - "BUTTONPROMPT, w\xE4hrend Sie SECONDPROMPT oder THIRDPROMPT in Richtung Wand
        halten"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Sword Thrust/Sword Thrust_Name
      TermType: 0
      Description: 
      Languages:
      - Sword Thrust
      - "Schwertsto\xDF"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Sword Thrust/Sword Thrust_Description
      TermType: 0
      Description: 
      Languages:
      - Charged attack, deals extra piercing damage to armored enemies.
      - "Aufgeladener Angriff, der gepanzerten Gegnern zus\xE4tzlichen Stichschaden
        zuf\xFCgt."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Sword Thrust/Sword Thrust_Instruction
      TermType: 0
      Description: 
      Languages:
      - Hold BUTTONPROMPT, release after 0.5s
      - "Halten Sie BUTTONPROMPT gedr\xFCckt und lassen Sie es nach 0,5 Sekunden
        los"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Whip/Whip_Name
      TermType: 0
      Description: 
      Languages:
      - Whip
      - Peitsche
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Whip/Whip_Description
      TermType: 0
      Description: 
      Languages:
      - It's not just a sword!? The manual did not say anything about this!
      - Es ist nicht nur ein Schwert!? Im Handbuch stand dazu nichts!
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Whip/Whip_Instruction
      TermType: 0
      Description: 
      Languages:
      - BUTTONPROMPT
      - BUTTONPROMPT
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Skull Throw/Skull Throw_Name
      TermType: 0
      Description: 
      Languages:
      - Skull Throw
      - Totenkopfwurf
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Skull Throw/Skull Throw_Description
      TermType: 0
      Description: 
      Languages:
      - Throw to provoke enemy or create a distraction. Can be used to stun weak
        enemies.
      - "Werfen, um den Feind zu provozieren oder ihn abzulenken. Kann verwendet
        werden, um schwache Feinde zu bet\xE4uben."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Skull Throw/Skull Throw_Instruction
      TermType: 0
      Description: 
      Languages:
      - Hold BUTTONPROMPT, then move the mouse to Aim
      - "Halten Sie BUTTONPROMPT gedr\xFCckt und bewegen Sie dann die Maus auf \u201EZielen\u201C."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Shadow Morph/Shadow Morph_Name
      TermType: 0
      Description: 
      Languages:
      - Shadow Morph
      - Schattenmorph
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Shadow Morph/Shadow Morph_Description
      TermType: 0
      Description: 
      Languages:
      - Embrace the shadow, be one in the shadow, be the shadow.
      - Umarme den Schatten, sei eins im Schatten, sei der Schatten.
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Shadow Morph/Shadow Morph_Instruction
      TermType: 0
      Description: 
      Languages:
      - Press BUTTONPROMPT to Morph
      - "Dr\xFCcken Sie BUTTONPROMPT zum Morphen"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Earth Shaker/Earth Shaker_Name
      TermType: 0
      Description: 
      Languages:
      - Earth Shaker
      - "Erdsch\xFCtterer"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Earth Shaker/Earth Shaker_Description
      TermType: 0
      Description: 
      Languages:
      - You jump and slam down to make an explosion.
      - "Sie springen und schlagen zu, um eine Explosion auszul\xF6sen."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Earth Shaker/Earth Shaker_Instruction
      TermType: 0
      Description: 
      Languages:
      - BUTTONPROMPT + SECONDPROMPT while in mid-air
      - BUTTONPROMPT + SECONDPROMPT in der Luft
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Whip/Whip_Command
      TermType: 0
      Description: 
      Languages:
      - Press BUTTONPROMPT
      - "Dr\xFCcken BUTTONPROMPT"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Wall Movement/Wall Movement_Command
      TermType: 0
      Description: 
      Languages:
      - Hold SECONDPROMPT/THIRDPROMPT + press BUTTONPROMPT
      - "SECONDPROMPT/THIRDPROMPT gedr\xFCckt halten + BUTTONPROMPT dr\xFCcken"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Sword Thrust/Sword Thrust_Command
      TermType: 0
      Description: 
      Languages:
      - Hold BUTTONPROMPT for 0.5s
      - "Die Taste BUTTONPROMPT 0,5 Sekunden lang gedr\xFCckt halten."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Skull Throw/Skull Throw_Command
      TermType: 0
      Description: 
      Languages:
      - Hold BUTTONPROMPT + aim with Mouse
      - "Taste gedr\xFCckt halten + mit der Maus zielen"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Shadow Slide/Shadow Slide_Command
      TermType: 0
      Description: 
      Languages:
      - Hold BUTTONPROMPT + press SECONDPROMPT
      - "BUTTONPROMPT gedr\xFCckt halten + SECONDPROMPT dr\xFCcken"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Shadow Morph/Shadow Morph_Command
      TermType: 0
      Description: 
      Languages:
      - Press BUTTONPROMPT
      - "Dr\xFCcken BUTTONPROMPT"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Shadow Dash/Shadow Dash_Command
      TermType: 0
      Description: 
      Languages:
      - Press BUTTONPROMPT
      - "Dr\xFCcken BUTTONPROMPT"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Earth Shaker/Earth Shaker_Command
      TermType: 0
      Description: 
      Languages:
      - Press BUTTONPROMPT + SECONDPROMPT
      - "Dr\xFCcken BUTTONPROMPT + SECONDPROMPT"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Double Jump/Double Jump_Command
      TermType: 0
      Description: 
      Languages:
      - Press BUTTONPROMPT while mid-air
      - "Dr\xFCcken BUTTONPROMPT, w\xE4hrend Sie in der Luft sind."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Devil WIngs/Devil Wings_Command
      TermType: 0
      Description: 
      Languages:
      - Hold BUTTONPROMPT mid-air
      - "Halten Sie die Taste BUTTONPROMPT in der Luft gedr\xFCckt."
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Dash/Dash_Command
      TermType: 0
      Description: 
      Languages:
      - Press BUTTONPROMPT
      - "Dr\xFCcken BUTTONPROMPT"
      Flags: 0000
      Languages_Touch: []
    - Term: PrimarySkill/Black Blood Immunity/Black Blood Immunity_Command
      TermType: 0
      Description: 
      Languages:
      - Black Blood Immune
      - Schwarzes Blut Immun
      Flags: 0000
      Languages_Touch: []
