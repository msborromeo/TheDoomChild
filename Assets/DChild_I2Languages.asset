    - Term: Dialogue System/Conversation/2/Entry/1/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=necroIdleExpression] Finally arriving home! Let''s go to the Throne
        Room and maybe we''ll find out what happened to you, and...'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/2/Entry/2/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=crazyKnightGoofy] And..? ANNNNND..?'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/2/Entry/3/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=necroFrustratedExpression] ...Nothing important.'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/2/Entry/4/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=crazyKnightGoofy] Really!? You don''t want to tell? Well, I know a
        way to loosen your tongue.'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/2/Entry/5/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=necroFrustratedExpression] NO! STOP IT..! STOP IT!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/2/Entry/6/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=necroTalkingExpression] It wasn''t just the Doomed Knight who lost
        part of his memories, even I''m missing some pages myself!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/2/Entry/7/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=crazyKnightDoubtful] Don''t worry, it''s normal! Some lose hair, and
        some lose memory!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/2/Entry/8/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=crazyKnightLaughing] ...and you don''t have hair, so I guess it''s
        obvious!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/2/Entry/9/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - "[pic=necroIdleExpression] What\u2014 What's obvious?"
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/2/Entry/10/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=crazyKnightGoofy] That you''re old!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/2/Entry/11/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=playerThinkingExpression] So both of us lost our memories, how about
        you, our crazy companion?'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/2/Entry/12/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=crazyKnightDoubtful] Hey! I have a name!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/2/Entry/13/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=necroFrustratedExpression] Then how about you enlighten us!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/2/Entry/14/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=crazyKnightGoofy] My name is Abel Fortwith Inuktitut Lorette! (Anagram:
        I know the truth but I fear to tell it.)'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/2/Entry/15/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=necroFrustratedExpression] Why did we even bother asking, that isn''t
        even a name!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/2/Entry/16/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=necroTalkingExpression] That was just foolish blabbing! It doesn''t
        even make sense why it''s so long!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/2/Entry/17/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=crazyKnightDoubtful] And Necronomicon is short? Heh, from now on I''m
        calling you Necro!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/2/Entry/18/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=necroFrustratedExpression] Alright then, I''ll call you Abel!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/2/Entry/19/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=crazyKnightLaughing] THAT ISN''T EVEN MY NAME! It''s Alberto Hewe Hotlink
        Tuttifrutti!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/2/Entry/20/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=necroTalkingExpression] Heh, sure it is!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/2/Entry/21/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=playerExcitedExpression] ALRIGHT, STOP THIS!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/2/Entry/22/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=necroSmirkingExpression] You''re right, instead of this madman we should
        be talking to other people, at least they''ll probably help!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/3/Title
      TermType: 0
      Description: 
      Languages:
      - Three People Coming Your Way
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/3/Entry/0/Title
      TermType: 0
      Description: 
      Languages:
      - START
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/3/Entry/0/Sequence
      TermType: 0
      Description: 
      Languages:
      - None()
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/3/Entry/1/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - This city is terrible and you should never go there! I'm telling you, it's
        filled with thieves, murderers, and scammers!
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/3/Entry/2/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - Don't listen to him! He is sometimes the worst scammer himself!
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/3/Entry/3/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - Michael! Stop these accusations!
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/3/Entry/4/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - I personally took a liking to it, you can simply break into houses and take
        whatever you want!
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/3/Entry/5/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - The only bad part is, at times we'd have to kill someone!
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/3/Entry/6/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - You're more likely referring to how we would have gotten killed almost all
        the time! Hospitality looks different!
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/3/Entry/7/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - You're back. The city was waiting for your return.
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/3/Entry/8/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - There are guests waiting for you in the Throne Room, my Lord.
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/3/Entry/9/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=playerThinkingExpression] Guests? Who are they?'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/3/Entry/10/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - It's, well... (whisper) I don't dare to say it, my Liege!
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/3/Entry/11/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=necroFrustratedExpression] You have to answer when you are asked to!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/3/Entry/12/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=necroTalkingExpression] For denying the Doomed Knight''s command is
        denying the Black Death himself!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/3/Entry/14/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - HAHAHA! A joke just came to mind!
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/3/Entry/15/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - While two pairs of pants were being washed, they met with one another with
        one of them asking the other "Wow! You're brown, were you on holiday?"
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/3/Entry/16/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=necroIdleExpression] Well that''s new, a scared Mordenkain citizen.'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/3/Entry/17/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=playerExcitedExpression] It''s okay, we''ll find out who these guests
        are!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/3/Entry/18/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - Thank you!
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/3/Entry/19/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=playerFacingAwayExpression] Really unsettling.'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/3/Entry/20/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=necroTalkingExpression] Indeed!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/220/Title
      TermType: 0
      Description: 
      Languages:
      - Inside the City
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/220/Entry/0/Title
      TermType: 0
      Description: 
      Languages:
      - START
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/220/Entry/0/Sequence
      TermType: 0
      Description: 
      Languages:
      - None()
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/220/Entry/1/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - You're finally back! Were you able to punish all of those Rebels?
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/220/Entry/2/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=playerIdleExpression] We''re trying to. It''s only a matter of time
        until we strike down this uprising! Hail to the Black Death!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/220/Entry/3/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - Hail to the Lord of the Dead!
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/220/Entry/4/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=necroFrustratedExpression] Ah, these kinds of religious believers!
        The Lord of the Dead, it''s all a fairy tale!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/220/Entry/5/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - If that's what you believe in, it's your belief and not mine.
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/220/Entry/6/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=necroTalkingExpression] Believe whatever you want to believe! Do you
        know anything about the guests arriving here?'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/220/Entry/7/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - I believe in things not existing. Anyways, I would say that you'd need to
        be more specific about arriving guests as there's always a lot of people
        that come to Mordenkain!
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/220/Entry/8/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=necroFrustratedExpression] Alright, let''s go!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/220/Entry/10/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - May the soul of the Lord of the Dead guide you!
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/221/Title
      TermType: 0
      Description: 
      Languages:
      - Entering the Prison
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/221/Entry/0/Title
      TermType: 0
      Description: 
      Languages:
      - START
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/221/Entry/0/Sequence
      TermType: 0
      Description: 
      Languages:
      - None()
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/221/Entry/1/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic = undeadGeneralAngryExpression] I have to admit, you''re a powerful
        foe! I''ve never met anyone as strong as you!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/221/Entry/2/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic = playerExcitedExpression] Tell me where your leader is and what he''s
        up to!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/221/Entry/3/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic = undeadGeneralAngryExpression] You should know by now! He''ll defeat
        the Black Death and free this world from his reign!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/221/Entry/4/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic = undeadGeneralIdleExpression] However, before we get to that he will
        gather his army and start by striking you down!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/221/Entry/5/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic = necroSmirkingExpression] Then how fortunate it is that his trusted
        General is already in custody!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/221/Entry/6/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic = undeadGeneralAngryExpression] Enough talk! I''d rather rot here in
        prison than to speak with you!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/221/Entry/7/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic = playerExcitedExpression] As you wish!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/222/Title
      TermType: 0
      Description: 
      Languages:
      - The Black Death Appears
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/222/Entry/0/Title
      TermType: 0
      Description: 
      Languages:
      - START
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/222/Entry/0/Sequence
      TermType: 0
      Description: 
      Languages:
      - None()
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/222/Entry/1/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic = blackDeathAngryExpression] In the Throne Room you will find our enemy!
        Don''t talk to him! He is infested with lies!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/222/Entry/2/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic = blackDeathIdleExpression] A master of masks! I will banish his magic
        of deception! Kill him and the uprising will come to a halt!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/222/Entry/3/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic = playerIdleExpression] Yes, Master.'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/222/Entry/4/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic = blackDeathIdleExpression] Don''t disappoint me!'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/222/Entry/5/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic = necroSmirkingExpression] We''ve never failed, and it''ll be staying
        that way.'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/222/Entry/6/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic = blackDeathIdleExpression] HAHAHA! Good, very good my servants! Go
        and serve my purpose!'
      - 
      Flags: 0000
      Languages_Touch: []
