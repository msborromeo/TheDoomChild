      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/227/Entry/1/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic = necroSmirkingExpression] With this item, I''m pretty sure we''ll
        be able to open some kind of passage somewhere around here in the Garden.'
      - 
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/227/Entry/2/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic = necroTalkingExpression] Judging by the way it looks, I feel like
        it needs to be placed on the hands of a statue!'
      - 
      Flags: 0000
      Languages_Touch: []
