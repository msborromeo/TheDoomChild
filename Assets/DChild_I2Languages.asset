'
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/58/Entry/4/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=necroFrustratedExpression] HEY! Pick me up! Get me off this disgusting
        ground!'
      - '[pic=necroFrustratedExpression] HEY! Hol mich ab! Holt mich von diesem ekelhaften
        Boden weg!'
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/58/Entry/5/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - '[pic=necroSmirkingExpression] FINALLY! Thanks for finally lifting me up!

'
      - '[pic=necroSmirkingExpression] ENDLICH! Danke, dass du mich endlich hochgehoben
        hast!

'
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/58/Entry/6/Dialogue Text
      TermType: 0
      Description: 
